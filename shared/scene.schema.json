{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sc-viz.local/schemas/scene.schema.json",
  "title": "SCVizScene",
  "description": "Declarative WebGL audio-reactive scene schema for SuperCollider real-time visualization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["layers"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0"],
      "default": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#09090b"
        },
        "trail": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.98,
          "default": 0.15
        },
        "fogDensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "default": 0.04
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "distance": {
          "type": "number",
          "minimum": 1,
          "maximum": 25,
          "default": 4.5
        },
        "fov": {
          "type": "number",
          "minimum": 20,
          "maximum": 110,
          "default": 50
        },
        "autoOrbit": {
          "type": "boolean",
          "default": false
        },
        "orbitSpeed": {
          "type": "number",
          "minimum": -5,
          "maximum": 5,
          "default": 0.25
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/definitions/Layer"
      }
    }
  },
  "definitions": {
    "ShapeType": {
      "type": "string",
      "enum": [
        "spiral",
        "polygon",
        "lissajous",
        "rings",
        "particles",
        "grid"
      ]
    },
    "SignalType": {
      "type": "string",
      "enum": [
        "amp",
        "loudness",
        "pitch",
        "pitchConf",
        "centroid",
        "flatness",
        "onset",
        "band",
        "voiceAmp",
        "voicePitch",
        "voiceCount"
      ]
    },
    "VisualTarget": {
      "type": "string",
      "enum": [
        "radius",
        "scale",
        "rotationX",
        "rotationY",
        "rotationZ",
        "hue",
        "saturation",
        "lightness",
        "opacity",
        "pulse",
        "turns",
        "twist",
        "spread",
        "zDepth",
        "thickness",
        "pointSize",
        "freqX",
        "freqY",
        "phase",
        "sides",
        "displacement"
      ]
    },
    "CurveType": {
      "type": "string",
      "enum": ["lin", "log", "exp"],
      "default": "lin"
    },
    "BlendMode": {
      "type": "string",
      "enum": ["normal", "additive"],
      "default": "additive"
    },
    "LayerParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "points": { "type": "integer", "minimum": 16, "maximum": 8000 },
        "turns": { "type": "number", "minimum": 0.25, "maximum": 32 },
        "sides": { "type": "integer", "minimum": 3, "maximum": 64 },
        "count": { "type": "integer", "minimum": 1, "maximum": 8000 },
        "ringCount": { "type": "integer", "minimum": 1, "maximum": 64 },
        "rows": { "type": "integer", "minimum": 2, "maximum": 128 },
        "cols": { "type": "integer", "minimum": 2, "maximum": 128 },
        "freqX": { "type": "number", "minimum": 0.1, "maximum": 24 },
        "freqY": { "type": "number", "minimum": 0.1, "maximum": 24 },
        "phase": { "type": "number", "minimum": -6.283185, "maximum": 6.283185 },
        "radius": { "type": "number", "minimum": 0.05, "maximum": 10 },
        "innerRadius": { "type": "number", "minimum": 0, "maximum": 9 },
        "scale": { "type": "number", "minimum": 0.05, "maximum": 10 },
        "spread": { "type": "number", "minimum": 0.1, "maximum": 12 },
        "zDepth": { "type": "number", "minimum": 0, "maximum": 10 },
        "twist": { "type": "number", "minimum": -12, "maximum": 12 },
        "thickness": { "type": "number", "minimum": 0.5, "maximum": 12 },
        "pointSize": { "type": "number", "minimum": 1, "maximum": 32 },
        "hue": { "type": "number", "minimum": 0, "maximum": 360 },
        "saturation": { "type": "number", "minimum": 0, "maximum": 100 },
        "lightness": { "type": "number", "minimum": 0, "maximum": 100 },
        "rotationX": { "type": "number", "minimum": -6.283185, "maximum": 6.283185 },
        "rotationY": { "type": "number", "minimum": -6.283185, "maximum": 6.283185 },
        "rotationZ": { "type": "number", "minimum": -6.283185, "maximum": 6.283185 },
        "displacement": { "type": "number", "minimum": 0, "maximum": 3 },
        "wireframe": { "type": "boolean" },
        "closed": { "type": "boolean" }
      }
    },
    "Mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "to"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "signal": {
          "$ref": "#/definitions/SignalType"
        },
        "bandIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15,
          "default": 0
        },
        "voiceIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15,
          "default": 0
        },
        "to": {
          "$ref": "#/definitions/VisualTarget"
        },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": -1000,
            "maximum": 1000
          },
          "default": [0, 1]
        },
        "curve": {
          "$ref": "#/definitions/CurveType"
        },
        "smooth": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.999,
          "default": 0.15
        },
        "attack": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.999
        },
        "decay": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.999
        },
        "invert": {
          "type": "boolean",
          "default": false
        },
        "clamp": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "Layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "params", "mappings"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "visible": {
          "type": "boolean",
          "default": true
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "blendMode": {
          "$ref": "#/definitions/BlendMode"
        },
        "shape": {
          "$ref": "#/definitions/ShapeType"
        },
        "params": {
          "$ref": "#/definitions/LayerParams"
        },
        "mappings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/definitions/Mapping"
          }
        }
      }
    }
  }
}
